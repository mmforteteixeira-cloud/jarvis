# ============================================================================
# JARVIS — Environment Configuration
# Copy this file to .env and fill in the values you have.
# Anything left blank stays in NOT_CONFIGURED state — JARVIS will say so
# instead of pretending the integration works.
# ============================================================================

# ---- Core ------------------------------------------------------------------
# "sqlite" (default, zero-cost local dev) or a postgres:// URL (production/Supabase)
DATABASE_URL=file:./data/jarvis.db

# Secret used to sign session/device tokens. Generate with: openssl rand -hex 32
JARVIS_SECRET=

# Base URL this app is served from (used for OAuth redirects, etc.)
JARVIS_BASE_URL=http://localhost:3000

# ---- AI Provider (JARVIS Core / Orchestrator / Planner / Content Agent) ----
# Preferred: Anthropic (Claude). Leave both blank to run in heuristic
# (non-LLM, rule-based) planning mode — clearly marked as DEMO in the UI.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Optional secondary/fallback provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Voice (Voice Abstraction Layer) ---------------------------------------
# ElevenLabs (TTS + optional STT). Without a key, JARVIS falls back to the
# browser's built-in Web Speech API (free, local, lower quality).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Research Agent / Web Search -------------------------------------------
# Free-tier friendly web search API (e.g. Brave Search, Tavily). Optional.
SEARCH_API_KEY=
SEARCH_PROVIDER=brave

# ---- Email Agent (Gmail OAuth) ---------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/email/oauth/callback

# ---- Content Agent / TikTok -------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/content/tiktok/callback

# ---- GitHub (Developer Agent) ----------------------------------------------
GITHUB_TOKEN=

# ---- Computer Agent (local device daemon, apps/computer-agent) -------------
# Shared secret the local Computer Agent daemon (jarvis-computer) uses to
# authenticate with this server. Must match COMPUTER_AGENT_TOKEN in
# apps/computer-agent/.env exactly. Generate with: openssl rand -hex 32
# Without this set, every /api/computer/device/* route refuses all
# requests — there is no unauthenticated pairing path.
COMPUTER_AGENT_TOKEN=

# ---- Supabase (optional managed Postgres + auth, alternative to sqlite) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Background worker ------------------------------------------------------
WORKER_POLL_INTERVAL_MS=3000
WORKER_HEARTBEAT_INTERVAL_MS=15000
