{
  "name": "@jarvis/computer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "jarvis-computer": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
