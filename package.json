{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "JARVIS — a modular, autonomous personal AI assistant.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @jarvis/web dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @jarvis/worker dev",
    "build": "pnpm -r --filter=./packages/** build && pnpm --filter @jarvis/web build && pnpm --filter @jarvis/worker build",
    "build:packages": "pnpm -r --filter=./packages/** build",
    "start:worker": "pnpm --filter @jarvis/worker start",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @jarvis/db migrate",
    "db:seed": "pnpm --filter @jarvis/db seed",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
