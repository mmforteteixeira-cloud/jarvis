# ============================================================================
# JARVIS Computer Agent (jarvis-computer) — local daemon configuration
# Copy to .env in this directory (apps/computer-agent/.env) and fill in.
# ============================================================================

# Master switch — the daemon refuses to start unless this is "true".
# Prevents an accidental `pnpm dev` from silently running a system-control
# daemon nobody asked for.
COMPUTER_AGENT_ENABLED=true

# Local port for the daemon's own diagnostic HTTP server (GET /health,
# GET /status). Not exposed to JARVIS Core — purely for local debugging,
# e.g. `curl http://localhost:8787/status`.
COMPUTER_AGENT_PORT=8787

# Directory the File/Directory commands are sandboxed to. Created if it
# doesn't exist. Never resolves outside this root, even via "../".
COMPUTER_AGENT_WORKSPACE=~/JARVIS/workspace

# Must match the JARVIS server's COMPUTER_AGENT_TOKEN exactly (same value
# in both .env files). Generate once with: openssl rand -hex 32
COMPUTER_AGENT_TOKEN=

# Where the JARVIS web server is running.
JARVIS_SERVER_URL=http://localhost:3000

# How this device identifies itself in the dashboard. Defaults to the
# machine's hostname if left blank.
COMPUTER_AGENT_DEVICE_NAME=

# Poll/heartbeat cadence.
COMPUTER_AGENT_POLL_INTERVAL_MS=2000
COMPUTER_AGENT_HEARTBEAT_INTERVAL_MS=15000
