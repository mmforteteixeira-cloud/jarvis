  },
  "dependencies": {
    "@jarvis/security": "workspace:*",
    "@jarvis/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  }
}
